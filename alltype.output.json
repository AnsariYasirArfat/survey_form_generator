        }
      ]
    },
    {
      "type": "matrix",
      "name": "question9",
      "columns": ["Column 1", "Column 2", "Column 3"],
      "rows": ["Row 1", "Row 2"]
    },
    {
      "type": "matrixdropdown",
      "name": "question10",
      "columns": [
        {
